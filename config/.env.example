# ============================================================================
# HERMES QUANT OPERATING SYSTEM - Configuration Template
# ============================================================================
# Owner: Mulky Malikul Dhaher
# Stage: Research Lab (Paper Trading Only)
# ============================================================================
# COPY this file to .env and fill in your values.
# NEVER commit .env with real keys to version control.
# ============================================================================

# ===========================================
# API PROVIDERS
# ===========================================

# NVIDIA API Configuration (Primary)
NVIDIA_API_KEY=
OPENAI_API_BASE=https://integrate.api.nvidia.com/v1
OPENAI_API_KEY=

# Groq API Configuration (Fast Inference)
GROQ_API_KEY=
GROQ_API_BASE=https://api.groq.com/openai/v1

# Additional Groq Keys (Load Balancing - optional)
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_API_KEY_6=

# OpenCode API Keys (optional)
OPENCODE_API_KEY_1=
OPENCODE_API_KEY_2=
OPENCODE_API_BASE=https://api.opencode.ai/v1

# ===========================================
# MODEL CONFIGURATION
# ===========================================

MODEL_NAME=meta/llama-3.1-nemotron-70b-instruct
DEFAULT_PROVIDER=groq
GROQ_MODEL=llama-3.1-8b-instant

# ===========================================
# TELEGRAM CONFIGURATION
# ===========================================

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=true

# ===========================================
# AGENT CONFIGURATION
# ===========================================

AGENT_NAME=HermesQuantOS
AGENT_VERSION=4.0.0
DEPLOYMENT_STAGE=research_lab
LOG_LEVEL=INFO
MAX_TOKENS=2048
TEMPERATURE=0.7

# ===========================================
# AUTO-RESTART CONFIGURATION
# ===========================================

AUTO_RESTART=true
RESTART_DELAY=5
MAX_RESTART_ATTEMPTS=0

# ===========================================
# PATHS (relative to project root)
# ===========================================

LOG_DIR=
DATA_DIR=

# ===========================================
# VISION API (Chart Vision Tool)
# ===========================================

VISION_PROVIDER=openai
OPENAI_VISION_KEY=

# ===========================================
# WALLET ADDRESSES
# ===========================================

WALLET_TRON=
WALLET_SHIBA=

# ===========================================
# DATABASE
# ===========================================

DATABASE_PATH=
